generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled (:6543, pgbouncer)
  directUrl = env("DIRECT_URL") // Supabase direct (:5432) — used by migrate
}

// ── Users & per-user configuration ──────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  // Nullable so the legacy-data import can create a user before they ever
  // sign in; ensureUser() claims the row by email match on first login.
  clerkId   String?  @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Discovery is admin-driven: only an admin (or a user the admin has granted
  // canScan) may trigger a catalog scan. The shared JobLead catalog is global;
  // each user's view of it is their UserLead overlay (status/score/application).
  isAdmin Boolean @default(false)
  canScan Boolean @default(false)

  profile      UserProfile?
  searchPref   SearchPreference?
  credential   UserCredential?
  projects     Project[]
  applications Application[]
  contacts     Contact[]
  emails       Email[]
  userLeads    UserLead[]
  scanRuns     ScanRun[]
  files        StoredFile[]
  interviewSessions InterviewSession[]
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String
  email             String // contact email printed on the resume (may differ from login email)
  phone             String?
  github            String?
  githubHandle      String?
  linkedin          String?
  linkedinHandle    String?
  portfolio         String?
  city              String?
  country           String?
  yearsOfExperience String?
  education         Json? // { degree, school, cgpa, grad }
  experience        Json   @default("[]") // [{ title, company, period, bullets: string[] }]
  extras            Json   @default("[]") // [{ title, org, period, summary }]
  updatedAt         DateTime @updatedAt
}

// Per-user project bank (replaces the hardcoded PROJECT_BANK module).
model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug      String
  title     String
  subtitle  String?
  tagline   String?
  oneLiner  String
  problem   String?
  approach  String?
  outcome   String?
  techStack String[]
  repoUrl   String?
  liveUrl   String?
  year      String?
  featured  Boolean @default(false)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
}

// Per-user discovery filters (replaces src/lib/discovery/config.ts).
model SearchPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  includeKeywords  String[]
  excludeKeywords  String[]
  locationKeywords String[]
  discoveryEnabled Boolean  @default(false) // off until the user saves locations
  // Per-user fit-scoring controls (edited from the Discover "Score now" panel,
  // persisted so scheduled discovery + repeat runs reuse them).
  scoreMaxPerScan  Int      @default(45) // cap on leads fit-scored per scoring run
  scoreRecencyDays Int      @default(14) // only score postings newer than this
  updatedAt        DateTime @updatedAt
}

// Per-user secrets: BYO DeepSeek key + SMTP creds (AES-256-GCM via
// src/lib/crypto.ts) and the hashed extension API token.
model UserCredential {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deepseekKeyEnc String? // stores the API key for whichever provider is selected
  llmProvider    String  @default("deepseek") // "deepseek" | "openrouter" | "gemini" | "openai"
  llmModel       String? // optional model override; falls back to provider default
  // Contact-finder lanes (cold-email enrichment), BYO + encrypted like the LLM key:
  apolloKeyEnc   String? // Apollo.io API key — "people at company by title" people-DB lane
  searchKeyEnc   String? // Serper.dev (Google search) API key — portfolio/personal-site lane
  smtpHost       String?
  smtpPort       Int?
  smtpUser       String? // an email address — not secret
  smtpPassEnc    String?
  smtpFromName   String?

  extensionTokenHash   String? @unique // sha256 hex of the full "yolo_…" token
  extensionTokenPrefix String? // first chars, display only
  updatedAt            DateTime @updatedAt
}

// Metadata for files living in the Supabase Storage bucket
// ({userId}/applications/{appId}/{kind} and {userId}/generic-resume.pdf).
model StoredFile {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  kind       String // "resume_pdf" | "resume_tex" | "cover_letter_pdf" | "generic_resume"
  filename   String
  mimeType   String
  size       Int
  bucketPath String @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // NULL applicationIds are distinct in Postgres — generic_resume uniqueness
  // is enforced in code (src/lib/files.ts deletes before insert).
  @@unique([applicationId, kind])
  @@index([userId, kind])
}

// ── Applications & outreach ─────────────────────────────────────────────────

model Application {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  company           String
  role              String
  source            String // "linkedin" | "portal" | "manual" | "cold_email"
  jdUrl             String?
  jdText            String?
  location          String?
  status            String  @default("draft") // draft | personalized | applied | replied | interview | offer | rejected | closed
  personalizeStatus String? // null | "running" | "failed" — drives a persistent loading state
  coverLetterText   String?
  applyUrl          String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  appliedAt         DateTime?
  events            Event[]
  contacts          Contact[]
  emails            Email[]
  files             StoredFile[]
  interviewSessions InterviewSession[]

  @@index([userId, status])
}

model Contact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  title         String?
  company       String
  email         String?
  linkedinUrl   String?
  source        String? // "manual" | "scrape" | "cold_email_target" | "discovered"
  domain        String? // company domain this contact was discovered under
  confidence    Float? // 0..1 — finder's confidence the email is right (null for manual)
  verified      Boolean      @default(false) // email confirmed real (published address or provider-verified)
  verifyMethod  String? // "published" | "apollo" | "mx" | "pattern"
  notes         String?
  createdAt     DateTime     @default(now())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  emails        Email[]

  @@index([userId])
}

model Email {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  toAddress     String
  toName        String?
  fromAddress   String
  subject       String
  body          String
  status        String    @default("draft") // draft | sent | replied | bounced | failed
  sentAt        DateTime?
  messageId     String?
  errorMessage  String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Full draft-page context, persisted so the contact detail view can reconstruct the original draft.
  recipientTitle   String?
  recipientCompany String?
  roleTarget       String? // role they were hiring for (if specified)
  hookContext      String? // the user-supplied hook / recent news / context
  rationale        String? // AI's one-line explanation of which proof point was chosen
  attachSource     String? // "personalized" | "generic" | "none"
  createdAt        DateTime @default(now())

  @@index([userId])
}

// ── Discovery ───────────────────────────────────────────────────────────────

// One global source-fetch per tick: the four sources are fetched ONCE, then
// fanned out per user (each user's filters/dedupe/scoring → their ScanRun).
model FetchRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  trigger     String    @default("cron") // "cron" | "manual" | "script"
  sourceStats String? // JSON SourceStats[] — per-source fetched/errors
  error       String?
  scanRuns    ScanRun[]
}

// A user's view of one discovery pass (their filter/ingest/score results).
model ScanRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  finishedAt  DateTime? // null while running (or if the process died mid-run)
  trigger     String    @default("manual") // "manual" | "cron" | "script"
  created     Int       @default(0)
  scored      Int       @default(0)
  sourceStats String? // JSON SourceStats[] — per-source fetched/created/dupes/errors
  error       String? // run-level failure or scoring error
  fetchRunId  String?
  fetchRun    FetchRun? @relation(fields: [fetchRunId], references: [id], onDelete: SetNull)
  leads       UserLead[]

  @@index([userId, startedAt])
}

// Global shared catalog: one row per posting, deduped across all users and
// sources. The per-user view (status/score/application) lives in UserLead.
model JobLead {
  id String @id @default(cuid())

  source        String // "sheet" | "jobfound" | "greenhouse" | "lever" | "ashby" | "hn"
  externalId    String // hygraph post id; for the sheet, a hash of company+role+date
  sources       String? // comma-separated list when the same posting was found in multiple sources
  company       String
  role          String
  location      String?
  url           String? // raw apply URL (sheet rows occasionally have none)
  canonicalUrl  String? // tracking params stripped — cross-source dedupe key
  jdText        String?
  salary        String?
  jobType       String? // "Full Time" | "Internship"
  experience    String?
  skills        String?
  postedAt      DateTime?
  contactEmail  String? // hiring contact when the source includes one (HN posts often do)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userLeads UserLead[]

  @@unique([source, externalId])
  @@index([canonicalUrl])
  @@index([postedAt])
}

// Per-user overlay on the shared catalog: this user's status, their personalized
// fit score, and the application they promoted it into. No row = status "new",
// no score. Rows are created lazily on promote/dismiss and during scoring.
model UserLead {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobLeadId String
  jobLead   JobLead @relation(fields: [jobLeadId], references: [id], onDelete: Cascade)

  status        String    @default("new") // new | promoted | dismissed
  applicationId String? // set on promote
  score         Int? // LLM fit score 0-100 (this user's key/profile)
  scoreReason   String?
  scanRunId     String? // the user scan that scored/surfaced it for them
  scanRun       ScanRun?  @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, jobLeadId])
  @@index([userId, status])
  @@index([scanRunId])
}

// Shared global ATS watchlist — board health/yield is tracked across all users.
model AtsCompany {
  id                  String    @id @default(cuid())
  ats                 String // "greenhouse" | "lever" | "ashby"
  slug                String // public board API token
  name                String
  active              Boolean   @default(true) // false = demoted (dead board), skipped by scans
  consecutiveFailures Int       @default(0) // fetch failures in a row; demoted at threshold
  lastError           String?
  lastFetchedAt       DateTime?
  lastMatchAt         DateTime? // last scan where this board yielded a lead passing the filters
  totalMatches        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([ats, slug])
  @@index([active])
}

// Global, domain-keyed contact-enrichment cache. Like the JobLead catalog, each
// company is enriched ONCE and the result is shared across every user: founder/HR
// email discovery burns small free API tiers (Apollo/Serper) and rate-limited
// public endpoints (GitHub), so re-running per user would be wasteful. The status
// field is the DB-backed source of truth for the "Find contacts" task lifecycle —
// it survives a tab close and lets the UI restore an in-flight run on reload.
model CompanyContactCache {
  id          String              @id @default(cuid())
  domain      String              @unique // normalized registrable domain, e.g. "acme.com"
  company     String? // display name from the lead that triggered enrichment
  status      String              @default("idle") // idle | running | completed | failed
  pattern     String? // inferred email pattern, e.g. "{first}.{last}"
  sourceStats String? // JSON: per-lane found counts + errors
  error       String?
  startedAt   DateTime?
  enrichedAt  DateTime? // last successful completion (drives the freshness TTL)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  contacts    DiscoveredContact[]
}

// One discovered person/email for a company (global, deduped by email per domain).
// Ranked candidates surface in the "Find contacts" UI; clicking one prefills the
// cold-email draft, and sending it materializes a per-user Contact (send route).
model DiscoveredContact {
  id      String              @id @default(cuid())
  cacheId String
  cache   CompanyContactCache @relation(fields: [cacheId], references: [id], onDelete: Cascade)

  name          String?
  title         String?
  email         String? // null = person located but address unresolved
  linkedinUrl   String?
  source        String // "lead" | "apollo" | "site" | "github" | "hn" | "portfolio" | "role_inbox" | "pattern"
  sources       String? // comma-separated when multiple lanes agreed on the same email
  confidence    Float   @default(0) // 0..1
  verified      Boolean @default(false)
  verifyMethod  String? // "published" | "apollo" | "mx" | "pattern"
  seniorityRank Int     @default(0) // higher = more senior/relevant (founder > lead > recruiter > IC)
  rank          Float   @default(0) // composite sort score (seniority × confidence × verified)
  createdAt     DateTime @default(now())

  @@index([cacheId])
}

// Singleton row (id=1) — admin sets a shared DeepSeek key with an expiry.
// Users without their own key fall back to this during the active window.
model SharedDeepseekKey {
  id          Int      @id @default(1)
  keyEnc      String   // AES-256-GCM encrypted via src/lib/crypto.ts
  llmProvider String   @default("deepseek")
  llmModel    String?  // optional model override
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
}

model Event {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // "status_change" | "personalized" | "applied" | "email_sent" | "note"
  detail        String?
  createdAt     DateTime    @default(now())
}

// ── Interview coach ─────────────────────────────────────────────────────────

// A mock-interview session. Browser-native voice (Web Speech API) is client-side
// only, so the backend exchanges TEXT: it plans topics, drives the depth-first
// cross-questioning (advanceTurn), grades each answer silently, and composes a
// report at wrap-up. Long-running-ops rules apply (src/lib/interview/lock.ts:
// per-session globalThis lock, DB-backed status for restore-on-reload).
model InterviewSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // null = general/resume-based; set = company-specific, grounded in the app's JD.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  mode         String // "company" | "general"
  persona      String  @default("neutral") // "neutral" | "friendly" | "stress"
  roundType    String  @default("mixed") // "behavioral" | "technical" | "mixed"
  // null = untimed (runs until topics exhaust). Else a TARGET length in minutes:
  // topic count scales to it and the interviewer winds down to end ~around it.
  timeLimitMin Int?
  status       String  @default("running") // running | completed | failed | abandoned
  topics       Json    @default("[]") // planned seeds: [{ title, kind, seed }]
  currentTopic Int     @default(0)
  report       Json? // composed at wrap-up from the hidden per-turn assessments
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  updatedAt    DateTime  @updatedAt
  turns        InterviewTurn[]

  @@index([userId, status])
}

// One interviewer line + the candidate's answer to it. `feedback` is the HIDDEN
// per-turn rubric (relevance/specificity/correctness/communication + note) — it
// drives the next move and the final report but is NEVER sent to the live UI,
// so the conversation stays in-character.
model InterviewTurn {
  id        String           @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  index      Int // monotonic order within the session
  topicIndex Int
  depth      Int     @default(0) // how deep into this topic's thread
  move       String // "SEED" | "DRILL" | "CHALLENGE" | "PIVOT" | "MOVE_ON"
  question   String // interviewer line (shown + spoken)
  answer     String? // candidate transcript (null until they respond)
  feedback   Json? // hidden assessment of `answer`
  createdAt  DateTime @default(now())

  @@index([sessionId, index])
}
