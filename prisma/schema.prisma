generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id            String   @id @default(cuid())
  company       String
  role          String
  source        String   // "linkedin" | "portal" | "manual" | "cold_email"
  jdUrl         String?
  jdText        String?
  location      String?
  status        String   @default("draft") // draft | personalized | applied | replied | interview | offer | rejected | closed
  resumeTexPath String?
  resumePdfPath String?
  personalizeStatus String?  // null | "running" | "failed" — drives a persistent loading state
  coverLetterText String?
  coverLetterPdfPath String?
  applyUrl      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  appliedAt     DateTime?
  events        Event[]
  contacts      Contact[]
  emails        Email[]
}

model Contact {
  id            String   @id @default(cuid())
  name          String
  title         String?
  company       String
  email         String?
  linkedinUrl   String?
  source        String?  // "manual" | "scrape" | "cold_email_target"
  notes         String?
  createdAt     DateTime @default(now())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  emails        Email[]
}

model Email {
  id            String   @id @default(cuid())
  toAddress     String
  toName        String?
  fromAddress   String
  subject       String
  body          String
  status        String   @default("draft") // draft | sent | replied | bounced | failed
  sentAt        DateTime?
  messageId     String?
  errorMessage  String?
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  // Full draft-page context, persisted so the contact detail view can reconstruct the original draft.
  recipientTitle String?
  recipientCompany String?
  roleTarget    String?  // role they were hiring for (if specified)
  hookContext   String?  // the user-supplied hook / recent news / context
  rationale     String?  // AI's one-line explanation of which proof point was chosen
  attachSource  String?  // "personalized" | "generic" | "none"
  createdAt     DateTime @default(now())
}

model ScanRun {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime? // null while running (or if the process died mid-run)
  trigger     String    @default("dashboard") // "dashboard" | "script"
  created     Int       @default(0)
  scored      Int       @default(0)
  sourceStats String?   // JSON SourceStats[] — per-source fetched/created/dupes/errors
  error       String?   // run-level failure or scoring error
  leads       JobLead[]
}

model JobLead {
  id            String   @id @default(cuid())
  source        String   // "sheet" | "jobfound" | (later: "greenhouse" | "lever" | "ashby" | "hn")
  externalId    String   // hygraph post id; for the sheet, a hash of company+role+date
  sources       String?  // comma-separated list when the same posting was found in multiple sources
  company       String
  role          String
  location      String?
  url           String?  // raw apply URL (sheet rows occasionally have none)
  canonicalUrl  String?  // tracking params stripped — cross-source dedupe key
  jdText        String?
  salary        String?
  jobType       String?  // "Full Time" | "Internship"
  experience    String?
  skills        String?
  postedAt      DateTime?
  contactEmail  String?  // hiring contact when the source includes one (HN posts often do)
  score         Int?     // LLM fit score 0-100 (phase 2)
  scoreReason   String?
  status        String   @default("new") // new | promoted | dismissed
  applicationId String?  // set on promote
  scanRunId     String?  // the scan that ingested this lead (null for pre-history leads)
  scanRun       ScanRun? @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([source, externalId])
  @@index([canonicalUrl])
  @@index([status, postedAt])
  @@index([scanRunId])
}

model AtsCompany {
  id                  String    @id @default(cuid())
  ats                 String    // "greenhouse" | "lever" | "ashby"
  slug                String    // public board API token
  name                String
  active              Boolean   @default(true) // false = demoted (dead board), skipped by scans
  consecutiveFailures Int       @default(0) // fetch failures in a row; demoted at threshold
  lastError           String?
  lastFetchedAt       DateTime?
  lastMatchAt         DateTime? // last scan where this board yielded a lead passing the filters
  totalMatches        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([ats, slug])
  @@index([active])
}

model Event {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String   // "status_change" | "personalized" | "applied" | "email_sent" | "note"
  detail        String?
  createdAt     DateTime @default(now())
}
