# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Project Settings → Database. DATABASE_URL is the pooled (pgbouncer, :6543)
# string for the app; DIRECT_URL is the direct (:5432) string for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Storage (resume/cover-letter PDFs) ─────────────────────────────
# Project Settings → API. The service-role key stays server-side only.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=yoloapply-files

# ── Clerk auth ───────────────────────────────────────────────────────────────
# https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Secrets encryption ───────────────────────────────────────────────────────
# 32 bytes base64; encrypts per-user DeepSeek keys + SMTP passwords at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# ── Server-level DeepSeek key ────────────────────────────────────────────────
# Used ONLY for global discovery work (HN thread extraction) — every user's own
# scoring/personalization runs on their personal key saved in Settings.
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Outlook / Microsoft 365 sending (optional) ───────────────────────────────
# Lets users connect an Outlook mailbox with one click instead of an app
# password; mail then goes out over Microsoft Graph. Leave blank to hide the
# Connect button and keep SMTP as the only sender.
#
# Set up once at https://entra.microsoft.com → Entra ID → App registrations →
# New registration:
#   - Supported account types: "Any Entra ID Tenant + Personal Microsoft
#     accounts" (anything narrower rejects work or personal accounts)
#   - Redirect URI (Web): this app's /api/oauth/microsoft/callback, for every
#     origin you run on — the match is exact
#   - Certificates & secrets → New client secret → copy the VALUE (not the ID)
#   - API permissions → Microsoft Graph → Delegated: Mail.Send, Mail.Read,
#     User.Read, offline_access. No admin consent needed; each user consents.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/oauth/microsoft/callback

# ── LaTeX compile mode ───────────────────────────────────────────────────────
# "local" (uses pdflatex/tectonic if present) or "remote"
LATEX_MODE=remote

# ── Scheduled discovery ──────────────────────────────────────────────────────
# Set to 1 on the deployed instance to run the every-3h global scan in-process.
ENABLE_CRON=0
