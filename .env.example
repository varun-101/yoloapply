# DeepSeek (OpenAI-compatible). Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Database
DATABASE_URL="file:./dev.db"

# Gmail SMTP — use an App Password (16 chars) from
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=varunchandwani101@gmail.com
SMTP_PASS=app-password-here
SMTP_FROM_NAME="Varun Chandwani"

# Owner profile (used in resume + cold-email defaults)
OWNER_NAME="Varun Chandwani"
OWNER_EMAIL=varunchandwani101@gmail.com
OWNER_PHONE="+91 xx"
OWNER_GITHUB=https://github.com/varun-101
OWNER_LINKEDIN=https://www.linkedin.com/in/varun-chandwani101/
OWNER_PORTFOLIO=https://www.varun101.dev

# Where to write generated .tex and .pdf
STORAGE_DIR=./storage

# LaTeX compile mode: "local" (uses pdflatex/tectonic if present) or "remote"
LATEX_MODE=remote

# Shared secret for the Chrome extension. Set this and paste the same value into
# the extension's Options page. Any random string works.
EXTENSION_API_KEY=dev-secret-change-me
